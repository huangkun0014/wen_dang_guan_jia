# ============================================
# 文档库管家 环境变量示例
# 复制为 .env 后按需修改；也可以全部留空，用首页「系统设置」配置。
# 优先级：代码默认值 < 环境变量 < shu_ju/she_zhi.json（网页设置）
# ============================================

# 文档库根目录（不填 = 项目内 文档库/）
WEN_DANG_KU=

# ---------- 应用台账库 ----------
# sqlite（默认，零配置）或 mssql
DB_LEI_XING=sqlite
SQLITE_LU_JING=shu_ju/wen_dang_ku.db

# DB_LEI_XING=mssql 时使用
SQL_SERVER=
SQL_YONG_HU=
SQL_MI_MA=
SQL_SHU_JU_KU=WenDangKu

# ---------- 考核库（可选，只读） ----------
KAO_HE_KAI_QI=false
KAO_HE_SQL_SERVER=
KAO_HE_YONG_HU=
KAO_HE_MI_MA=
KAO_HE_SHU_JU_KU=
KAO_HE_BIAO=

# ---------- DeepSeek ----------
DEEPSEEK_KEY=
DEEPSEEK_URL=https://api.deepseek.com
DEEPSEEK_MO_XING=deepseek-chat

# ---------- 图片识别 ----------
# deepseek（云端）或 lm_studio（本地）
TU_PIAN_SHI_BIE_QU_DAO=deepseek
TU_PIAN_SHI_BIE_URL=http://localhost:1234/v1
TU_PIAN_SHI_BIE_MO_XING=qwen3-vl-8b-instruct
DEEPSEEK_SHI_JUE_MO_XING=deepseek-flash

# ---------- 服务 ----------
PORT=8001
# 本机用 127.0.0.1；Docker/云平台用 0.0.0.0
FU_WU_HOST=127.0.0.1
MCP_HTTP_KAI_QI=true
MCP_HTTP_DUAN_KOU=8765

# AI 接口鉴权（可选，空=仅本机；公网部署建议设置）
AI_JIE_KOU_KEY=

# 可选：把网页设置文件放到别处
# SHE_ZHI_WEN_JIAN=shu_ju/she_zhi.json
